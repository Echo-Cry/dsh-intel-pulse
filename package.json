{
  "name": "dsh-intel-pulse",
  "version": "0.9.2",
  "type": "module",
  "description": "DSH全能资讯与状态中枢：自主全网热榜/自定义源/深度资讯检索，精选二次元动漫插画与点图采集（支持QQ/NapCat/IM机器人投递与收件箱画廊），全场景会话状态原生系统级Toast通知提醒。",
  "author": "Echo-Cry <kcrystal360049@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Echo-Cry/dsh-intel-pulse.git"
  },
  "homepage": "https://github.com/Echo-Cry/dsh-intel-pulse#readme",
  "bugs": {
    "url": "https://github.com/Echo-Cry/dsh-intel-pulse/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "intel-pulse",
    "notification",
    "toast",
    "news",
    "rss",
    "idle",
    "gallery",
    "illustration",
    "pixiv",
    "anime",
    "onebot",
    "napcat",
    "资讯推送",
    "会话弹窗",
    "系统提醒",
    "热榜",
    "图库采集",
    "二次元插画",
    "点图搜图"
  ],
  "icon": "./assets/icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  }
}
