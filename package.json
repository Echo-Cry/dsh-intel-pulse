{
  "name": "dsh-intel-pulse",
  "version": "0.9.0",
  "type": "module",
  "description": "自主搜索指定的网络资讯与精选二次元/色图插画推送，推送到会话或 IM；全局会话状态系统弹窗通知",
  "author": "Echo-Cry <kcrystal360049@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Echo-Cry/dsh-intel-pulse.git"
  },
  "homepage": "https://github.com/Echo-Cry/dsh-intel-pulse#readme",
  "bugs": {
    "url": "https://github.com/Echo-Cry/dsh-intel-pulse/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "intel-pulse",
    "notification",
    "news",
    "rss",
    "idle",
    "资讯推送",
    "会话弹窗",
    "热榜"
  ],
  "icon": "./assets/icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  }
}
